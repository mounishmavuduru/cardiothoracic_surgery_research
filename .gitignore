.venv/
__pycache__/
*.pyc
outputs/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
data/

# Human-subject outcome data (shared under restricted terms; never redistribute).
# data/ is already ignored above; these are belt-and-braces rules so a stray copy
# anywhere in the tree cannot be committed.
**/af_recurrence_outcomes*.csv
**/*_outcomes_shareable.csv

# Coq compiled artifacts
*.vo
*.vok
*.vos
*.glob
.*.aux
.lia.cache

# LaTeX build artifacts (the .tex source and compiled .pdf are tracked; these are not)
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
# Overleaf upload bundle (regenerate with `make overleaf-zip`; duplicates tracked files)
docs/paper/*_overleaf.zip
