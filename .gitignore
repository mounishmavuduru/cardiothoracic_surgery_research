data/

# Per-patient outcome data. The redistribution restriction was LIFTED 2026-07-30 --
# the cohort authors confirmed in writing that no confidentiality attaches to these
# outcomes (PRE_REGISTRATION.md §8.1) -- so committing this file is now permitted.
# The rules are kept anyway: permission to redistribute is not a decision to, and
# publishing patient-level data should be a deliberate act, not a side effect of
# `git add -A`. Remove these lines when that release is actually intended.
**/af_recurrence_outcomes*.csv
**/*_outcomes_shareable.csv

# Coq compiled artifacts
*.vo
*.vok
*.vos
*.glob
.*.aux
.lia.cache

# LaTeX build artifacts (the .tex source and compiled .pdf are tracked; these are not)
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
# Overleaf upload bundle (regenerate with `make overleaf-zip`; duplicates tracked files)
docs/paper/*_overleaf.zip

# Local TeX toolchain (tectonic.exe, ~20 MB binary; see docs/paper/README_BUILD.md)
tools/

# Transient stderr captures from script runs (e.g. accuracy_campaign.err)
*.err
